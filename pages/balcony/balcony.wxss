/* 阳台架计算器 —— 结构类复用 mortgage 页样式，配色跟工具箱蓝 #4a6cf7 */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.section {
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 24rpx;
}

.form-item {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.form-item .label {
  width: 200rpx;
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}

.input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 76rpx;
}

.input-wrap input {
  flex: 1;
  font-size: 28rpx;
}

.input-wrap .unit {
  font-size: 26rpx;
  color: #999;
  margin-left: 10rpx;
}

.tab-group {
  display: flex;
  gap: 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
}

.tab.active {
  background: linear-gradient(135deg, #667eea 0%, #4a6cf7 100%);
  color: #fff;
}

.plan-desc {
  margin: 16rpx 0 8rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.7;
}

.delta-item {
  margin-top: 16rpx;
  margin-bottom: 0;
}

/* 错误条（输入无效） */
.error-bar {
  margin: 0 24rpx 20rpx;
  background: #fff1f0;
  color: #cf1322;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

/* 1. 分布串大字卡（最核心一屏，可截图） */
.dist-card {
  background: linear-gradient(135deg, #667eea 0%, #4a6cf7 100%);
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  margin-bottom: 16rpx;
}

.dist-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-bottom: 16rpx;
}

.dist-text {
  display: block;
  font-family: Menlo, Consolas, monospace;
  font-size: 38rpx;
  font-weight: 600;
  color: #fff;
  word-break: break-all;
}

.dist-total {
  display: block;
  margin-top: 12rpx;
  font-family: Menlo, Consolas, monospace;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 2. 分区净宽 */
.zone-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.zone-card {
  flex: 1;
  background: #eef1fd;
  border-radius: 16rpx;
  padding: 24rpx 12rpx;
  text-align: center;
}

.zone-width {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #4a6cf7;
}

.zone-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}

/* 3-5. 清单行 */
.block-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin: 20rpx 0 8rpx;
}

.line-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.line-label {
  font-size: 26rpx;
  color: #666;
}

.line-value {
  font-size: 26rpx;
  color: #333;
}

.line-value .em {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.parts-note {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999;
}

/* 警告条 */
.warn-bar {
  margin-top: 16rpx;
  background: #fffbe6;
  color: #ad6800;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

/* 6. 台上盆提示卡 */
.tip-card {
  background: #fffdf5;
  border: 2rpx solid #ffe58f;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ad6800;
  margin-bottom: 12rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #8c6d1f;
  line-height: 1.8;
}

.tip-em {
  font-weight: 600;
  color: #ad6800;
}
