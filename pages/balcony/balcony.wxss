.page {
  padding: 40rpx 32rpx;
}

.build {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 56rpx;
}

.build-icon {
  font-size: 88rpx;
}

.build-title {
  margin-top: 20rpx;
  font-size: 38rpx;
  font-weight: 600;
}

.build-tag {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #4a6cf7;
  background: #eef1fd;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
}

.block {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.block-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.feature {
  color: #666;
  font-size: 26rpx;
  line-height: 1.9;
}

.example {
  font-family: Menlo, Consolas, monospace;
  font-size: 28rpx;
  color: #4a6cf7;
  background: #f6f8ff;
  border-radius: 12rpx;
  padding: 20rpx;
}

.example-note {
  margin-top: 12rpx;
  color: #999;
  font-size: 24rpx;
}
