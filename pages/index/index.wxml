<view class="page">
  <view class="header">
    <view class="title">生活工具箱</view>
    <view class="subtitle">算清楚再动手</view>
  </view>
  <view class="grid">
    <view
      class="card"
      wx:for="{{tools}}"
      wx:key="key"
      data-path="{{item.path}}"
      bindtap="onTapTool"
    >
      <view class="card-icon">{{item.icon}}</view>
      <view class="card-title">{{item.title}}</view>
      <view class="card-desc">{{item.desc}}</view>
      <view class="card-badge">{{item.badge}}</view>
    </view>
  </view>
</view>
