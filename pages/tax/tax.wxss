/* 自老项目移植：SCSS 嵌套平铺 + 小程序 button 默认样式重置 */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.section {
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 24rpx;
}

.form-item {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.form-item .label {
  width: 240rpx;
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}

.input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 76rpx;
}

.input-wrap input {
  flex: 1;
  font-size: 28rpx;
}

.input-wrap .unit {
  font-size: 26rpx;
  color: #999;
  margin-left: 10rpx;
}

.tag-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  background: #f0f0f0;
  border: 2rpx solid transparent;
}

.tag.active {
  background: #e8f0fe;
  color: #4a6cf7;
  border-color: #4a6cf7;
}

.calc-btn {
  margin: 30rpx 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.calc-btn::after {
  border: none;
}

.result-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.result-card {
  flex: 1;
  min-width: calc(50% - 16rpx);
  box-sizing: border-box;
  background: #f8f9ff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.result-card.highlight {
  min-width: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  margin-bottom: 16rpx;
}

.result-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.result-card.highlight .result-label {
  color: rgba(255, 255, 255, 0.8);
}

.result-value {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.result-card.highlight .result-value {
  color: #fff;
  font-size: 40rpx;
}

.bonus-section {
  border-top: 2rpx solid #eee;
  padding-top: 20rpx;
}

.bonus-title {
  margin-top: 20rpx;
}
